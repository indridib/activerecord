# Disabled for tests (see HARDENING.md "Waived findings"):
#   bugprone-unchecked-optional-access: the check does not model gtest ASSERT_TRUE(opt) /
#   ASSERT_TRUE(opt.has_value()) as a guard, so every guarded *opt in tests is a false positive
InheritParentConfig: true
Checks: >
  -bugprone-unchecked-optional-access
# Also report findings in shared test headers (tests/integration/test_adapters.h); the root
# filter only covers include/activerecord/. Does not match GoogleTest's headers under _deps/.
HeaderFilterRegex: '/(include/activerecord|tests/integration)/'
